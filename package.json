{
    "name": "auto-expand-on-enter",
    "displayName": "Auto Expand On Enter",
    "description": "auto expand braces ex.'(),[],{}' when pressing enter",
    "version": "0.3.2",
    "publisher": "ctf0",
    "repository": "https://github.com/ctf0/vscode-auto-expand-on-enter",
    "engines": {
        "vscode": "^1.110.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/main",
    "contributes": {
        "commands": [
            {
                "command": "autoExpand.newLine",
                "title": "Auto Expand"
            },
            {
                "command": "autoExpand.content",
                "title": "Auto Expand: Content"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "autoExpand.newLine",
                    "when": "false"
                },
                {
                    "command": "autoExpand.content",
                    "when": "editorFocus && !editorReadonly"
                }
            ]
        },
        "keybindings": [
            {
                "command": "autoExpand.newLine",
                "key": "enter",
                "when": "editorTextFocus && !suggestWidgetVisible && !editorHasSelection"
            },
            {
                "command": "autoExpand.content",
                "key": "alt+cmd+.",
                "when": "editorIsOpen && !editorReadonly"
            }
        ],
        "configuration": {
            "title": "Auto Expand On Enter",
            "type": "object",
            "properties": {
                "autoExpandOnEnter.list": {
                    "type": "object",
                    "default": {
                        "(": ")",
                        "{": "}",
                        "{{": "}}",
                        "{!!": "!!}",
                        "{{--": "--}}",
                        "[": "]",
                        ">": "<"
                    },
                    "description": "start & end chars list"
                },
                "autoExpandOnEnter.languages": {
                    "type": "array",
                    "default": [
                        "php",
                        "typescript",
                        "html",
                        "blade",
                        "css",
                        "markdown"
                    ],
                    "items": {
                        "type": "string"
                    },
                    "description": "languages to expand"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run esbuild-base -- --pure:console.log --minify",
        "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
        "esbuild": "npm run esbuild-base -- --sourcemap",
        "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
        "watch": "npm run typecheck && npm run esbuild",
        "typecheck": "tsc --noEmit",
        "test": "node --test 'build/*.test.js'"
    },
    "devDependencies": {
        "@types/vscode": "^1.110.0",
        "typescript": "^7.0.2",
        "esbuild": "^0.28.1"
    },
    "dependencies": {
        "escape-string-regexp": "^5.0.0"
    }
}
